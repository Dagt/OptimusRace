# Paste into Railway Variables and replace placeholders; never commit real values.
DEBUG=0
LOAD_DOTENV=0
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
DATABASE_URL=${{Postgres.DATABASE_URL}}
TRUST_PROXY_SSL=1
MEDIA_STORAGE=r2
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE
R2_SECRET_ACCESS_KEY=REPLACE
R2_BUCKET_NAME=optimus-race-photos
WEB_THREADS=4
ALLOW_LIVE_PAYMENTS=0
# PUBLIC_URL defaults to https://RAILWAY_PUBLIC_DOMAIN.
# Add SMTP settings before enabling password recovery for real users.
