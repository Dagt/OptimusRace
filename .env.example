# Se carga automáticamente desde .env. Las variables del proceso tienen prioridad.
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
PUBLIC_URL=http://127.0.0.1:8000
# SECRET_KEY=secreto-aleatorio-largo-para-produccion
# DATABASE_PATH=C:/OptimusData/db.sqlite3
# MEDIA_ROOT=C:/OptimusData/media
# BACKUP_DIR=C:/OptimusBackups
STRIPE_MODE=test
ALLOW_LIVE_PAYMENTS=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para entregar recuperación por correo:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Optimus Race <noreply@example.com>
# Despliegue detrás de un proxy confiable que reemplaza X-Forwarded-Proto:
# TRUST_PROXY_SSL=1
# CSRF_TRUSTED_ORIGINS=https://race.example.com
